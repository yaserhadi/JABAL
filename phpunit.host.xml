<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Positive/path-specific Enterprise SSO contracts run in the Path job.
                 Host has paired negative-gate tests and must never enter SSO flow. -->
            <group>path-profile-contract</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2fl+Ktvk6xXez0bNPaffH2eLxMBdFf6T0nDNGfE1Gnc="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE_CENTRAL" value="jabal_central_testing"/>
        <env name="DB_DATABASE_TENANT" value="jabal_tenant_shared_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- BK-073 Host-profile suite: Path Enterprise SSO positive HTTP surfaces are skipped via trait;
             Host negative SSO gate is covered under tests/Feature/Tenancy. -->
        <env name="TENANCY_ADDRESSING_PROFILE" value="host" force="true"/>
        <env name="TENANCY_CANONICAL_SCHEME" value="https" force="true"/>
        <env name="TENANT_PLATFORM_BASE_DOMAIN" value="jabal.test" force="true"/>
        <env name="TENANCY_CENTRAL_HOSTS" value="localhost,127.0.0.1,jabal.test,platform.jabal.test,auth.jabal.test,api.jabal.test" force="true"/>
        <env name="TENANCY_PLATFORM_HOST" value="platform.jabal.test" force="true"/>
        <env name="TENANCY_AUTH_HOST" value="auth.jabal.test" force="true"/>
        <env name="TENANCY_API_HOST" value="api.jabal.test" force="true"/>
        <env name="APP_URL" value="https://platform.jabal.test" force="true"/>
        <!-- BK-098: enable local_sealed for Host Identity SSO tests. -->
        <env name="SECRET_RUNTIME_CLASS" value="test" force="true"/>
        <env name="LOCAL_SEALED_ENABLED" value="true" force="true"/>
        <env name="LOCAL_SEALED_STORE_PATH" value="storage/framework/testing/local_sealed_store" force="true"/>
        <env name="LOCAL_SEALED_UNSEAL_KEY_FILE" value="storage/framework/testing/local_sealed_unseal.key" force="true"/>
    </php>
</phpunit>
