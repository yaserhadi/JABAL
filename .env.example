# =============================================================================
# JABAL — environment template (copy to .env and customize)
# =============================================================================
# Canonical reference for local development. Never commit .env with real secrets.
# Testing uses phpunit.xml overrides (jabal_central_testing / jabal_tenant_shared_testing).
# See tests/README.md and docs/reports/TEST_DB_ISOLATION_INCIDENT.md.
# =============================================================================

APP_NAME=Jabal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Platform operator (PlatformAdminSeeder — central platform_users only; not a tenant user)
APP_ADMIN_EMAIL=admin@jabal.test
APP_ADMIN_NAME="Platform Admin"
APP_ADMIN_PASSWORD=password

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL — dual database (TENANCY-DUAL-DB lock)
# central: platform_users, tenants, platform_sessions, billing, …
# tenant:  application users, sessions, RBAC, workspaces, …
# -----------------------------------------------------------------------------
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE_CENTRAL=jabal_central
DB_DATABASE_TENANT=jabal_tenant_shared
DB_USERNAME=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Tenancy (ADR-0007 / Stage 3 design)
# Full guide: docs/reference/tenancy-environment.md
# Config: config/tenancy_storage.php — use TENANCY_MODE=shared_db for all current installs
# -----------------------------------------------------------------------------
TENANCY_MODE=shared_db
TENANCY_IDENTIFICATION=path
TENANCY_SHARED_DB_CONNECTION=tenant
TENANCY_DB_CREATION_MODE=manual
# manual: R2 pending until `php artisan tenant:provision-storage {tenant}`; automatic: provision inline during onboarding
TENANCY_DEFAULT_ISOLATION=shared
TENANCY_ALLOW_DATABASE_PER_TENANT=true
TENANCY_ALLOW_SCHEMA_PER_TENANT=false

# -----------------------------------------------------------------------------
# Tenant addressing (BK-073 / DEC-0023)
# Valid: host | path  (host_redirect / Profile C deferred to BK-096 — fails boot)
# Host is architectural default; local Path remains a supported alternative.
# -----------------------------------------------------------------------------
TENANCY_ADDRESSING_PROFILE=path
TENANT_PLATFORM_BASE_DOMAIN=jabal.test
TENANCY_PLATFORM_HOST=localhost
TENANCY_AUTH_HOST=localhost
TENANCY_API_HOST=
TENANCY_ASSET_HOST=
TENANCY_OPERATIONS_HOST=
TENANCY_CENTRAL_HOSTS=localhost,127.0.0.1,jabal.test,platform.jabal.test,auth.jabal.test,api.jabal.test
TENANCY_CANONICAL_SCHEME=http
TENANCY_CANONICAL_PORT=
# Trusted proxies: never "*". Leave empty unless behind a reverse proxy.
TENANCY_TRUSTED_PROXIES=
TENANCY_TRUST_FORWARDED_HEADERS=false

# -----------------------------------------------------------------------------
# Sessions — Stage 2.5 isolated runtime (ADR-0007 §3.1.3.1)
# -----------------------------------------------------------------------------
# HTTP web: ConfigureApplicationRuntime selects profile before StartSession.
#   Platform (/platform/*) → central.platform_sessions + PLATFORM_SESSION_COOKIE
#   Tenant (login, /t/{tenant}/*) → tenant.sessions + TENANT_SESSION_COOKIE
# SESSION_CONNECTION is CLI / artisan / PHPUnit fallback only — not platform web.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=tenant
PLATFORM_SESSION_COOKIE=jabal_platform_session
TENANT_SESSION_COOKIE=jabal_tenant_session

# Optional auth defaults (tenant guard preferred; web = deprecated alias)
# AUTH_GUARD=web
# AUTH_PASSWORD_BROKER=tenant_users

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Lab / UAT Mailpit (BK-112) — OPTIONAL supported profile, NOT the default
# ---------------------------------------------------------------------------
# Use only on Owner workstation / local Jabal + Cloudflare Tunnel UAT.
# Mailpit is lab tooling: prove Jabal → SMTP → inbox UI without reading laravel.log.
# Do NOT make Mailpit a mandatory local or CI dependency. Do NOT use for production.
#
# 1) Start standalone Mailpit with SMTP+UI on loopback only (verify binds):
#      SMTP 127.0.0.1:1025
#      UI   127.0.0.1:8025
#    Never expose SMTP publicly or via Tunnel. UI-only temporary tunnel if needed.
# 2) Copy the block below into your local/UAT .env (uncomment), then:
#      php artisan config:clear
# 3) Smoke with a development-safe operational send (no product route/UI). See:
#      .cursor/reports/BK_112_LAB_UAT_MAIL_TRANSPORT_INBOX.md
# 4) Rollback: set MAIL_MAILER=log (and restore MAIL_PORT if desired), config:clear.
#
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="lab-mail@jabal.test"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
